# Copy to .env if you want. The process reads the environment, not this file.
# Leave a value empty to keep that feature off.

PORT=8787
DRYRUN_PRICE_USD=5
# NEAR account that receives deep-review payments. Empty: quotes are dry.
DRYRUN_RECIPIENT=
# Optional 1Click partner token. Lower fee. Never commit a real token.
ONECLICK_JWT=
# NEAR AI Cloud key from cloud.near.ai. Empty: free checks still run; deep review returns 503.
NEAR_AI_API_KEY=
# Optional. Unset: deep review uses z-ai/glm-5.3, criteria and idea notes use z-ai/glm-5.3-flash.
# zai-org/GLM-5.1-FP8 is a deprecated alias. Do not set it.
# NEAR_AI_MODEL=
# Optional. Default low. medium and high spend more of the token budget on reasoning.
# NEAR_AI_REASONING_EFFORT=low
# 1 skips payment. Do not set this on a public host.
DRYRUN_FREE_DEEP=
# Optional. Raises the GitHub search rate limit used to match unnamed repos.
GITHUB_TOKEN=
# 0 disables the background directory scan. Free check still works.
DRYRUN_SCAN=1
DRYRUN_DATA=./data
# 1 also asks NEAR AI Cloud to score each cloned leaderboard repo. Off by default.
DRYRUN_AI_BOARD=
